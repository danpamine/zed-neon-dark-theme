{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "NeonDark",
  "author": "Ported from ItzSudhan/NeonDark-Theme",
  "themes": [
    {
      "name": "NeonDark",
      "appearance": "dark",
      "style": {
        "background.appearance": "opaque",
        "background": "#120e16",
        "surface.background": "#1a171e",
        "panel.background": "#120e16",
        "elevated_surface.background": "#1a171e",
        "text": "#ABB2BF",
        "text.muted": "#ffffff9c",
        "text.placeholder": "#5C6370",
        "text.accent": "#7000ff",
        "border": "#1a171e",
        "border.variant": "#1a171e",
        "editor.background": "#120e16",
        "editor.foreground": "#ABB2BF",
        "editor.gutter.background": "#120e16",
        "editor.line_number": "#5C6370",
        "editor.active_line_number": "#a148f0",
        "editor.active_line.background": "#1a171e",
        "editor.selection.background": "#6b3ea7",
        "editor.indent_guide": "#2a2530",
        "editor.indent_guide_active": "#3a3340",
        "editor.document_highlight.read_background": "#6b3ea740",
        "editor.document_highlight.write_background": "#6b3ea760",
        "editor.document_highlight.bracket_background": "#7000ff30",
        "status_bar.background": "#7000ff",
        "title_bar.background": "#1a171e",
        "toolbar.background": "#120e16",
        "tab_bar.background": "#1a171e",
        "tab.active_background": "#120e16",
        "tab.inactive_background": "#1a171e",
        "tab.active_foreground": "#a148f0",
        "tab.inactive_foreground": "#ffffff9c",
        "search.match_background": "#6b3ea7",
        "pane.focused_border": "#7000ff",
        "pane_group.border": "#1a171e",
        "terminal.background": "#120e16",
        "terminal.foreground": "#ABB2BF",
        "terminal.bright_foreground": "#ffffff",
        "terminal.dim_foreground": "#5C6370",
        "terminal.ansi.black": "#120e16",
        "terminal.ansi.bright_black": "#5C6370",
        "terminal.ansi.red": "#E06C75",
        "terminal.ansi.bright_red": "#BE5046",
        "terminal.ansi.green": "#98C379",
        "terminal.ansi.bright_green": "#98C379",
        "terminal.ansi.yellow": "#E5C07B",
        "terminal.ansi.bright_yellow": "#E5C07B",
        "terminal.ansi.blue": "#61AFEF",
        "terminal.ansi.bright_blue": "#61AFEF",
        "terminal.ansi.magenta": "#C678DD",
        "terminal.ansi.bright_magenta": "#C678DD",
        "terminal.ansi.cyan": "#56B6C2",
        "terminal.ansi.bright_cyan": "#56B6C2",
        "terminal.ansi.white": "#ABB2BF",
        "terminal.ansi.bright_white": "#ffffff",
        "syntax": {
          "comment": { "color": "#5C6370", "font_style": "italic" },
          "string": { "color": "#98C379" },
          "number": { "color": "#D19A66" },
          "constant": { "color": "#D19A66" },
          "constant.builtin": { "color": "#56B6C2" },
          "boolean": { "color": "#56B6C2" },
          "character.escape": { "color": "#56B6C2" },
          "variable": { "color": "#E06C75" },
          "variable.parameter": { "color": "#ABB2BF" },
          "variable.builtin": { "color": "#E06C75" },
          "function": { "color": "#61AFEF" },
          "function.builtin": { "color": "#56B6C2" },
          "type": { "color": "#E5C07B" },
          "type.builtin": { "color": "#56B6C2" },
          "keyword": { "color": "#C678DD" },
          "keyword.modifier": { "color": "#ABB2BF" },
          "operator": { "color": "#C678DD" },
          "tag": { "color": "#E06C75" },
          "attribute": { "color": "#D19A66" },
          "property": { "color": "#ABB2BF" },
          "punctuation": { "color": "#ABB2BF" },
          "label": { "color": "#61AFEF" }
        }
      }
    }
  ]
}
